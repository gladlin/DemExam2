<Page x:Class="DemExam2.Pages.CountProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemExam2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Рассчитать материалы">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="0,75,0,0">
            <TextBlock Text="Рассчитать количество материала" Margin="5" Width="270" Height="15"/>

            <TextBlock Text="Количество получаемой продукции" Width="270" Height="15" Margin="0,15,0,0"/>
            <TextBox x:Name="tbNeedAmount" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Наименование материала" Width="270" Height="15" Margin="0,15,0,0"/>
            <ComboBox x:Name="cmbMaterialName" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Количество необходимого материала:" Width="270" Height="15" Margin="0,15,0,0"/>
            <TextBlock x:Name="tbNeedMaterial" Margin="5" Width="270" Height="25"/>

            <Button x:Name="btnCount" Content="Посчитать" Background="#2D6033" Foreground="White"  Margin="5" Width="150" Height="30" Click="btnCount_Click"/>
        </StackPanel>
    </Grid>
</Page>
