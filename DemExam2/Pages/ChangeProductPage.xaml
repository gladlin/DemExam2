<Page x:Class="DemExam2.Pages.ChangeProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemExam2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Изменение продукта">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="0,76,10,0">
            <TextBlock Text="Изменение данных о продукте" Margin="5" Width="270" Height="15" HorizontalAlignment="Center"/>

            <TextBlock Text="Тип продукта" Width="270" Height="15"/>
            <ComboBox x:Name="cmbProductType" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Наименование продукта" Width="270" Height="15"/>
            <TextBox x:Name="tbProductName" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Артикул" Width="270" Height="15"/>
            <TextBox x:Name="tbArticul" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Минимальная стоимость для партнера" Width="270" Height="15"/>
            <TextBox x:Name="tbMinPrice" Margin="5" Width="270" Height="25"/>

            <TextBlock Text="Ширина" Width="270" Height="15"/>
            <TextBox x:Name="tbWide" Margin="5" Width="270" Height="25"/>

            <Button x:Name="btnSave" Content="Сохранить" Background="#2D6033" Foreground="White"  Margin="5" Width="150" Height="30" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
