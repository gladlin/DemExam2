<Page x:Class="DemExam2.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemExam2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список продуктов">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190*"/>
            <ColumnDefinition Width="350*"/>
            <ColumnDefinition Width="120*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="85,0,0,0" Grid.ColumnSpan="3">
            <Button x:Name="btnCountMaterial"  Background="#2D6033" Foreground="White"  Content="Расчитать количество материала" Visibility="Hidden" Click="btnCountMaterial_Click" Width="200"  Grid.Row="0" Margin="5"/>
            <Button x:Name="btnChangeProduct"  Background="#2D6033" Foreground="White"  Content="Редактировать продукт" Visibility="Hidden" Click="btnChangeProduct_Click" Width="200"  Grid.Row="0" Margin="5"/>
            <Button x:Name="btnAddProduct"  Background="#2D6033" Foreground="White"  Content="Добавить продукт"  Click="btnAddProduct_Click" Grid.Row="0" Grid.ColumnSpan="3" Margin="5" Width="200"/>
        </StackPanel>
        <ListView Name="LViewProduct" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" Margin="5, 5, 5, 5" d:ItemsSource="{d:SampleData ItemCount=1}" SelectionChanged="LViewProduct_SelectionChanged" MouseDoubleClick="LViewProduct_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="{Binding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProductType}" FontSize="16"/>
                                    <TextBlock Text="{Binding ProductName, StringFormat=' | \{0}'}" FontSize="16"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Articule, StringFormat='Артикул: \{0}'}"/>
                                <TextBlock Text="{Binding MinPrice, StringFormat='Минимальная стоимость для партнера: \{0}(р)'}"/>
                                <TextBlock Text="{Binding Wide, StringFormat='Ширина \{0} (м)'}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='\{0:F2} (р)'}" VerticalAlignment="Center" FontSize="16" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
